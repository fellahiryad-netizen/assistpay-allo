# ---------------------------------------------------------------------------
# Connexion PostgreSQL utilisée par l'application.
#  - Serveur de l'entreprise : postgresql://assistpay:MOT_DE_PASSE@localhost:5432/assistpay
#  - Supabase (hébergement Vercel) : chaîne « Transaction pooler » (port 6543), en ajoutant à la fin
#    ?sslmode=require&uselibpqcompat=true
#    exemple : postgresql://postgres.abcdefghijkl:MOT_DE_PASSE@aws-0-eu-central-1.pooler.supabase.com:6543/postgres?sslmode=require&uselibpqcompat=true
DATABASE_URL="postgresql://assistpay:MOT_DE_PASSE@localhost:5432/assistpay"

# Uniquement pour Supabase : chaîne « Session pooler » (port 5432), utilisée pour créer les tables (npm run db:migrate).
#    exemple : postgresql://postgres.abcdefghijkl:MOT_DE_PASSE@aws-0-eu-central-1.pooler.supabase.com:5432/postgres?sslmode=require
# DIRECT_URL=""

# Clé de signature des sessions : 32 caractères minimum (générer avec : openssl rand -base64 48)
SESSION_SECRET="remplacer-par-une-longue-chaine-aleatoire-de-48-caracteres"
# Durée d'une session, en heures
SESSION_TTL_HOURS="12"
# "true" dès que le site est servi en HTTPS (toujours le cas sur Vercel)
COOKIE_SECURE="false"
